msgid "who was too short to live"
msgstr "som var för kort för att leva"

msgid "who tunneled away from me like a frightened mole"
msgstr "som tunnlade iväg från mig som en uppskrämd mullvad"

msgid "who sucked plump helmets like a purring maggot"
msgstr "som sög i sig fetthjälmar som en spinnande larv"

msgid "whose hammer shattered on the anvil of my power"
msgstr "vars hammare splittrades på städet av min kraft"

msgid "who forged [PRO_POS] own doom by challenging me"
msgstr "som beseglade [PRO_POS] egen undergång genom att utmana mig"

msgid "who was returned to the rock and muck from which it was spawned"
msgstr "som återfördes till den sten och dy varur den skapades"

msgid ""
"whose tall tales of bravery were all the more embarrassing because of "
"[PRO_POS] height"
msgstr ""
"vars skrönor om tapperhet blev desto pinsammare på grund av [PRO_POS] längd"

msgid "who was felled like a slender sapling"
msgstr "som fälldes som en späd planta"

msgid "whom I sent back to the home-tree as fertilizer"
msgstr "som jag skickade tillbaka till hemträdet som gödsel"

msgid "whose fragile bones shattered before the power of my contempt"
msgstr "vars sköra ben krossades inför mitt förakts kraft"

msgid "who came down from the home-tree and was devoured"
msgstr "som kom ned från hemträdet och blev uppäten"

msgid ""
"who should have stayed in the trees when the real elves came down to fight"
msgstr ""
"som borde ha stannat i träden när de riktiga alverna kom ned för att slåss"

msgid "I want your bones for my bone mill!"
msgstr "Jag vill ha dina ben till min benkvarn!"

msgid "I'll grind you into porridge!"
msgstr "Jag kommer mosa dig till gröt!"

msgid "I'll eat you whole!"
msgstr "Jag kommer äta dig hel!"

