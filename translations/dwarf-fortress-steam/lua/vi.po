msgstr "nó có vẻ được bao phủ bởi những mỏm đá gồ ghề"

#. CONSOLATION={add="it radiates a sad kindness"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1810
msgctxt "sphere_flavor"
msgid "it radiates a sad kindness"
msgstr "nó tỏa ra một sự tốt bụng buồn bã"

#. COURAGE={add="it makes those around it feel brave"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1811
msgctxt "sphere_flavor"
msgid "it makes those around it feel brave"
msgstr "nó khiến những kẻ xung quanh cảm thấy dũng cảm"

#. CRAFTS={add="it appears constructed"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1812
msgctxt "sphere_flavor"
msgid "it appears constructed"
msgstr "nó có vẻ như được tạo tác nên"

#. CREATION={add="small objects seem to pop into existence around it"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1813
msgctxt "sphere_flavor"
msgid "small objects seem to pop into existence around it"
msgstr "các vật nhỏ dường như đột ngột xuất hiện xung quanh nó"

#. DANCE={add="it whirls, skips and jumps whenever it moves"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1814
msgctxt "sphere_flavor"
msgid "it whirls, skips and jumps whenever it moves"
msgstr "nó xoay tít, nhảy cóc và nhảy múa mỗi khi di chuyển"

#. DARKNESS={add="it is difficult to see clearly even in bright light"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1815
msgctxt "sphere_flavor"
msgid "it is difficult to see clearly even in bright light"
msgstr "thật khó để nhìn rõ ngay cả dưới ánh sáng rực rỡ"

#. DAWN={add="it always turns to welcome the rise of the sun"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1816
msgctxt "sphere_flavor"
msgid "it always turns to welcome the rise of the sun"
msgstr "nó luôn quay mình chào đón mặt trời mọc"

#. DAY={add="it hums pleasantly when the sun is high in the sky"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1817
msgctxt "sphere_flavor"
msgid "it hums pleasantly when the sun is high in the sky"
msgstr "nó kêu vo ve dễ chịu khi mặt trời lên cao trên bầu trời"

#. DEATH={add="it has a rattling exhale"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1818
msgctxt "sphere_flavor"
msgid "it has a rattling exhale"
msgstr "nó thở ra tiếng khò khè như tiếng lạch cạch"

#. DEFORMITY={add="its body is bent and misshapen"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1819
msgctxt "sphere_flavor"
msgid "its body is bent and misshapen"
msgstr "cơ thể nó cong vẹo và dị dạng"

#. DEPRAVITY={add="it slavers uncontrollably"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1820
msgctxt "sphere_flavor"
msgid "it slavers uncontrollably"
msgstr "nó chảy dãi không kiểm soát"

#. DISCIPLINE={add="it moves with great focus"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1821
msgctxt "sphere_flavor"
msgid "it moves with great focus"
msgstr "nó di chuyển với sự tập trung cao độ"

#. DISEASE={add="it bears malodorous pustules",odor="death"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1822
msgctxt "sphere_flavor"
msgid "it bears malodorous pustules"
msgstr "nó mang những mụn mủ bốc mùi hôi thối"

#. DISEASE={add="it bears malodorous pustules",odor="death"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1822
msgctxt "sphere_flavor"
msgid "death"
msgstr "cái chết"

#. DREAMS={add="the details of its form are easily forgotten without
#. deliberate
#. concentration"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1823
msgctxt "sphere_flavor"
msgid ""
"the details of its form are easily forgotten without deliberate "
"concentration"
msgstr ""
"các chi tiết về hình dạng của nó rất dễ bị quên lãng nếu không cố gắng tập "
"trung"

#. DUSK={add="it never looks toward the sun"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1824
msgctxt "sphere_flavor"
msgid "it never looks toward the sun"
msgstr "nó không bao giờ nhìn về phía mặt trời"

#. DUTY={add="it is utterly still when not taking deliberate action"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1825
msgctxt "sphere_flavor"
msgid "it is utterly still when not taking deliberate action"
msgstr "nó hoàn toàn đứng yên khi không thực hiện hành động có chủ đích"

#. EARTH={add="it looks very solid and stocky"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1826
msgctxt "sphere_flavor"
msgid "it looks very solid and stocky"
msgstr "nó trông rất vững chắc và vạm vỡ"

#. FAMILY={add="it appears to be closely related to every other of its kind"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1827
msgctxt "sphere_flavor"
msgid "it appears to be closely related to every other of its kind"
msgstr "nó có vẻ có họ hàng gần gũi với mọi cá thể cùng loài khác"

#. FAME={add="fanfare follows it wherever it goes"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1828
msgctxt "sphere_flavor"
msgid "fanfare follows it wherever it goes"
msgstr "tiếng kèn trống vang dội theo chân nó đi bất cứ đâu"

#. FATE={add="it never appears to be perturbed or surprised by any happening"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1829
msgctxt "sphere_flavor"
msgid "it never appears to be perturbed or surprised by any happening"
msgstr ""
"nó dường như không bao giờ bối rối hay ngạc nhiên trước bất kỳ sự việc nào"

#. FERTILITY={add="it appears to be very healthy"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1830
msgctxt "sphere_flavor"
msgid "it appears to be very healthy"
msgstr "nó trông rất khỏe mạnh"

#. FESTIVALS={add="it skips and twirls as it moves"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1831
msgctxt "sphere_flavor"
msgid "it skips and twirls as it moves"
msgstr "nó nhảy nhót và xoay vòng khi di chuyển"

#. FIRE={add="a sheen around it always seems to rise upward"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1832
msgctxt "sphere_flavor"
msgid "a sheen around it always seems to rise upward"
msgstr "một lớp ánh sáng mờ quanh nó luôn dường như bốc lên phía trên"

#. FISH={add="it only looks comfortable when it is in the water"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1833
msgctxt "sphere_flavor"
msgid "it only looks comfortable when it is in the water"
msgstr "nó chỉ trông thoải mái khi ở dưới nước"

#. FISHING={add="it always moves carefully around water"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1834
msgctxt "sphere_flavor"
msgid "it always moves carefully around water"
msgstr "nó luôn di chuyển cẩn thận xung quanh vùng nước"

#. FOOD={add="it has the delicious smell of freshly-baked
#. goods",odor="freshly-baked goods"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1835
msgctxt "sphere_flavor"
msgid "it has the delicious smell of freshly-baked goods"
msgstr "nó mang mùi hương thơm ngon của bánh vừa nướng"

#. FOOD={add="it has the delicious smell of freshly-baked
#. goods",odor="freshly-baked goods"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1835
msgctxt "sphere_flavor"
msgid "freshly-baked goods"
msgstr "bánh vừa nướng"

#. FORGIVENESS={add="it is impossible to hold a grudge near it"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1836
msgctxt "sphere_flavor"
msgid "it is impossible to hold a grudge near it"
msgstr "thật không thể nuôi lòng thù hận khi ở gần nó"

#. FORTRESSES={add="it is very sturdy-looking"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1837
msgctxt "sphere_flavor"
msgid "it is very sturdy-looking"
msgstr "nó trông rất chắc chắn"

#. FREEDOM={add="it eagerly moves from place to place"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1838
msgctxt "sphere_flavor"
msgid "it eagerly moves from place to place"
msgstr "nó háo hức di chuyển từ nơi này sang nơi khác"

#. GAMBLING={add="it changes between two colors intermittently"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1839
msgctxt "sphere_flavor"
msgid "it changes between two colors intermittently"
msgstr "nó đổi màu liên hồi giữa hai sắc thái"

#. GAMES={add="it giggles at random"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1840
msgctxt "sphere_flavor"
msgid "it giggles at random"
msgstr "nó khúc khích cười một cách ngẫu nhiên"

#. GENEROSITY={add="it makes those around it want to give up their
#. possessions"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1841
msgctxt "sphere_flavor"
msgid "it makes those around it want to give up their possessions"
msgstr "nó khiến những kẻ xung quanh muốn từ bỏ tài sản của mình"

#. HAPPINESS={add="it seems to smile constantly"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1842
msgctxt "sphere_flavor"
msgid "it seems to smile constantly"
msgstr "nó có vẻ mỉm cười liên tục"

#. HEALING={add="it is surrounded by a gentle atmosphere"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1843
msgctxt "sphere_flavor"
msgid "it is surrounded by a gentle atmosphere"
msgstr "nó được bao quanh bởi một bầu không khí dịu nhẹ"

#. HOSPITALITY={add="it radiates an aura of welcoming"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1844
msgctxt "sphere_flavor"
msgid "it radiates an aura of welcoming"
msgstr "nó tỏa ra hào quang chào đón"

#. HUNTING={add="it inspects the ground intently as it moves"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1845
msgctxt "sphere_flavor"
msgid "it inspects the ground intently as it moves"
msgstr "nó chăm chú quan sát mặt đất khi di chuyển"

#. INSPIRATION={add="flashes of energy pulse across its surface
#. intermittently"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1846
msgctxt "sphere_flavor"
msgid "flashes of energy pulse across its surface intermittently"
msgstr "những tia năng lượng lóe lên nhịp nhàng trên bề mặt nó"

#. JEALOUSY={add="it appears to be a very bitter creature"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1847
msgctxt "sphere_flavor"
msgid "it appears to be a very bitter creature"
msgstr "nó trông có vẻ là một sinh vật đầy cay đắng"

#. JEWELS={add="its whole body appears to be faceted in a symmetric fashion"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1848
msgctxt "sphere_flavor"
msgid "its whole body appears to be faceted in a symmetric fashion"
msgstr "toàn bộ cơ thể nó trông giống như được mài mặt đối xứng"

#. JUSTICE={add="it seems eager to pronounce judgment on others"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1849
msgctxt "sphere_flavor"
msgid "it seems eager to pronounce judgment on others"
msgstr "nó tỏ ra hào hứng phán quyết kẻ khác"

#. LABOR={add="it appears very deliberate in its actions"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1850
msgctxt "sphere_flavor"
msgid "it appears very deliberate in its actions"
msgstr "nó tỏ ra rất có chủ đích trong mọi hành động"

#. LAKES={add="it moves ponderously"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1851
msgctxt "sphere_flavor"
msgid "it moves ponderously"
msgstr "nó di chuyển nặng nhọc"

#. LAWS={add="it has a very stark look about it"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1852
msgctxt "sphere_flavor"
msgid "it has a very stark look about it"
msgstr "nó mang một vẻ ngoài rất nghiêm ngặt"

#. LIES={add="it seems unerringly honest if one does not concentrate"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1853
msgctxt "sphere_flavor"
msgid "it seems unerringly honest if one does not concentrate"
msgstr "nó có vẻ cực kỳ trung thực nếu không chú ý kỹ"

#. LIGHT={add="it returns surrounding light with a new vibrance and
#. intensity"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1854
msgctxt "sphere_flavor"
msgid "it returns surrounding light with a new vibrance and intensity"
msgstr "nó phản chiếu ánh sáng xung quanh với độ rực rỡ và cường độ mới"

#. LIGHTNING={add="it crackles with energy"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1855
msgctxt "sphere_flavor"
msgid "it crackles with energy"
msgstr "nó lép bép phát ra năng lượng"

#. LONGEVITY={add="it always seems to be looking far into the distance"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1856
msgctxt "sphere_flavor"
msgid "it always seems to be looking far into the distance"
msgstr "nó luôn có vẻ đang nhìn ra xa xăm"

#. LOVE={add="it stares longingly at those nearby"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1857
msgctxt "sphere_flavor"
msgid "it stares longingly at those nearby"
msgstr "nó nhìn đắm đuối những kẻ ở gần"

#. LOYALTY={add="it never abandons its companions"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1858
msgctxt "sphere_flavor"
msgid "it never abandons its companions"
msgstr "nó không bao giờ bỏ rơi đồng đội"

#. LUCK={add="it changes direction suddenly at times"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1859
msgctxt "sphere_flavor"
msgid "it changes direction suddenly at times"
msgstr "thỉnh thoảng nó đổi hướng đột ngột"

#. LUST={add="it has an unnerving stare"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1860
msgctxt "sphere_flavor"
msgid "it has an unnerving stare"
msgstr "nó có ánh nhìn làm người ta mất tự nhiên"

#. MARRIAGE={add="it heckles those it meets that are not married"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1861
msgctxt "sphere_flavor"
msgid "it heckles those it meets that are not married"
msgstr "nó chế giễu những kẻ chưa kết hôn mà nó gặp"

#. MERCY={add="it always seems like it is on the verge of crying"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1862
msgctxt "sphere_flavor"
msgid "it always seems like it is on the verge of crying"
msgstr "nó lúc nào cũng như sắp khóc đến nơi"

#. METALS={add="it appears to have sharp shimmering edges on many parts of its
#. body"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1863
msgctxt "sphere_flavor"
msgid "it appears to have sharp shimmering edges on many parts of its body"
msgstr "nó có vẻ có các cạnh sắc lấp lánh trên nhiều bộ phận cơ thể"

#. MINERALS={add="it has an angular appearance"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1864
msgctxt "sphere_flavor"
msgid "it has an angular appearance"
msgstr "nó có vẻ ngoài góc cạnh"

#. MISERY={add="it has a distinctly depressing moan"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1865
msgctxt "sphere_flavor"
msgid "it has a distinctly depressing moan"
msgstr "nó phát ra tiếng rên rỉ u ám rõ rệt"

#. MIST={add="it is difficult to see clearly"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1866
msgctxt "sphere_flavor"
msgid "it is difficult to see clearly"
msgstr "thật khó để nhìn rõ"

#. MOON={add="it changes color with the phases of the moon"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1867
msgctxt "sphere_flavor"
msgid "it changes color with the phases of the moon"
msgstr "nó đổi màu theo các pha của mặt trăng"

#. MOUNTAINS={add="it is very solidly built"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1868
msgctxt "sphere_flavor"
msgid "it is very solidly built"
msgstr "nó có kết cấu rất vững chãi"

#. MUCK={add="there is a foul reek about it"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1869
msgctxt "sphere_flavor"
msgid "there is a foul reek about it"
msgstr "quanh nó phảng phất mùi hôi thối"

#. MURDER={add="it cannot abide anything that lives"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1870
msgctxt "sphere_flavor"
msgid "it cannot abide anything that lives"
msgstr "nó không thể dung thứ cho bất cứ thứ gì có sự sống"

#. MUSIC={add="it sounds clear tones as its body moves in time"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1871
msgctxt "sphere_flavor"
msgid "it sounds clear tones as its body moves in time"
msgstr "nó phát ra âm điệu trong trẻo theo nhịp chuyển động của cơ thể"

#. NATURE={add="it seems most at ease when it is outdoors"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1872
msgctxt "sphere_flavor"
msgid "it seems most at ease when it is outdoors"
msgstr "nó có vẻ thoải mái nhất khi ở ngoài trời"

#. NIGHT={add="it eerily reflects the light of the stars and moon"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1873
msgctxt "sphere_flavor"
msgid "it eerily reflects the light of the stars and moon"
msgstr "nó phản chiếu ánh sáng của sao và mặt trăng một cách kỳ quái"

#. NIGHTMARES={add="it reminds those that look upon it of their most
#. unpleasant
#. memories"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1874
msgctxt "sphere_flavor"
msgid "it reminds those that look upon it of their most unpleasant memories"
msgstr "nó gợi cho những ai nhìn vào về những ký ức tồi tệ nhất của họ"

#. OATHS={add="it cannot look directly at somebody that has broken an oath"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1875
msgctxt "sphere_flavor"
msgid "it cannot look directly at somebody that has broken an oath"
msgstr "nó không thể nhìn thẳng vào kẻ đã phá vỡ lời thề"

#. OCEANS={add="it always raises a part of its body toward the moon"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1876
msgctxt "sphere_flavor"
msgid "it always raises a part of its body toward the moon"
msgstr "nó luôn giơ một phần cơ thể về phía mặt trăng"

#. ORDER={add="it moves very stiffly"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1877
msgctxt "sphere_flavor"
msgid "it moves very stiffly"
msgstr "nó di chuyển rất cứng nhắc"

#. PAINTING={add="its surface is always enlivened with a refreshing play of
#. color"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1878
msgctxt "sphere_flavor"
msgid "its surface is always enlivened with a refreshing play of color"
msgstr "bề mặt của nó luôn sinh động với các sắc thái màu tươi tắn"

#. PEACE={add="it has an incredibly calm demeanor"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1879
msgctxt "sphere_flavor"
msgid "it has an incredibly calm demeanor"
msgstr "nó có phong thái vô cùng điềm tĩnh"

#. PERSUASION={add="it rocks back and forth whenever somebody changes their
#. mind in its presence"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1880
msgctxt "sphere_flavor"
msgid ""
"it rocks back and forth whenever somebody changes their mind in its presence"
msgstr "nó lắc lư qua lại mỗi khi ai đó thay đổi ý định trước mặt nó"

#. PLANTS={add="it always seems to point toward the sun when it is in the
#. sky"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1881
msgctxt "sphere_flavor"
msgid "it always seems to point toward the sun when it is in the sky"
msgstr "nó dường như luôn hướng về phía mặt trời khi ở trên bầu trời"

#. POETRY={add="it recites verses in a strange language on occasion"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1882
msgctxt "sphere_flavor"
msgid "it recites verses in a strange language on occasion"
msgstr "thỉnh thoảng nó ngâm các câu thơ bằng một ngôn ngữ lạ"

#. PREGNANCY={add="it appears to be expecting"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1883
msgctxt "sphere_flavor"
msgid "it appears to be expecting"
msgstr "nó trông có vẻ đang mang thai"

#. RAIN={add="it leaves water wherever it goes"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1884
msgctxt "sphere_flavor"
msgid "it leaves water wherever it goes"
msgstr "nó để lại nước bất cứ nơi nào nó đi qua"

#. RAINBOWS={add="it is strikingly colored"}
#: data/vanilla/vanilla_procedural/scripts/generators/creatures.lua:1885
msgctxt "sphere_flavor"
msgid "it is strikingly colored"
msgstr "nó mang màu sắc sặc sỡ nổi bật"

#. REBIRTH={add="it alternates from instant to instant between sluggishness
#. and
#. extreme vibrancy"}
